# Deep Research Agent — Backend Environment Variables
# Copy this to .env and fill in your values:
#   copy .env.example .env

# Required: Web search API (free tier: 1000 searches/month)
TAVILY_API_KEY=

# Optional: OpenCode Zen API key (if needed)
OPENCODE_API_KEY=

# Optional: Fallback LLM
OPENAI_API_KEY=

# Server config
SERVER_HOST=0.0.0.0
SERVER_PORT=8123
LOG_LEVEL=info

# Default model (free OpenCode Zen model)
MODEL_NAME=deepseek-v4-flash-free

# Limits
RATE_LIMIT_PER_MINUTE=5
MAX_RESEARCH_STEPS=10
